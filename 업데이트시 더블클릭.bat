@echo off
:: ==============================================
:: 완전자동: Git 반영 + 서버 실행 + 웹페이지 열기
:: ==============================================

:: 현재 배치파일 위치로 이동 (한글 경로 문제 방지)
cd /d "%~dp0"

:: ==============================
:: 1. Git 상태 확인
:: ==============================
echo ==============================
echo Git 상태 확인...
git status
echo ==============================

:: ==============================
:: 2. 변경 사항 Git에 자동 추가
:: ==============================
echo 변경 사항 자동 추가 중...
git add .
echo ==============================

:: ==============================
:: 3. 커밋 메시지 자동 생성
:: ==============================
set "MSG=Update files on %date% %time%"
git commit -m "%MSG%" 2>nul
if %ERRORLEVEL% NEQ 0 (
    echo 변경사항 없음, 커밋할 내용이 없습니다.
) else (
    echo 커밋 완료: %MSG%
)

:: ==============================
:: 4. 원격 저장소에 자동 푸시
:: ==============================
git push origin main 2>nul
if %ERRORLEVEL% NEQ 0 (
    echo 푸시 실패! 원격 저장소 설정 확인 필요
) else (
    echo 원격 저장소에 푸시 완료
)
echo ==============================

:: ==============================
:: 5. Flask 서버 실행
:: ==============================
echo Flask 서버 실행 중...
start "" python app.py

:: ==============================
:: 6. 브라우저 자동 열기
:: ==============================
timeout /t 2 >nul
start "" http://127.0.0.1:5000

:: ==============================
echo ======================================
echo 완전 자동 실행 완료!
echo 웹페이지 열림 + Git 반영 완료
echo ======================================
pause